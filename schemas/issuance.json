{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/marty-protocol/marty-protocol/main/schemas/issuance.json",
  "title": "IssuanceTransaction",
  "description": "Public management projection of a tenant-scoped credential issuance transaction. OAuth tokens, pre-authorized codes, custody selectors, signing-service identifiers, keys, and raw credential payloads are excluded.",
  "type": "object",
  "required": ["id", "organization_id", "credential_template_id", "status", "created_at"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1, "maxLength": 255},
    "organization_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "credential_template_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "applicant_id": {"type": ["string", "null"], "maxLength": 255},
    "application_id": {"type": ["string", "null"], "maxLength": 255},
    "subject_did": {"type": ["string", "null"], "pattern": "^did:", "maxLength": 2048},
    "status": {
      "type": "string",
      "enum": ["pending", "authorized", "signing", "issued", "failed", "expired", "revoked"]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "issued_at": {"type": ["string", "null"], "format": "date-time"},
    "revoked_at": {"type": ["string", "null"], "format": "date-time"},
    "revocation_reason": {"type": ["string", "null"], "maxLength": 2000}
  }
}
