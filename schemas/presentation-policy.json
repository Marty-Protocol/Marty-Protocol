{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/marty-protocol/marty-protocol/main/schemas/presentation-policy.json",
  "title": "PresentationPolicy",
  "description": "Minimum disclosure requirements, predicates, and holder binding for credential verification",
  "type": "object",
  "required": [
    "id",
    "organization_id",
    "name",
    "status",
    "required_claims",
    "accepted_credential_types",
    "holder_binding",
    "prefer_predicates",
    "supported_circuits",
    "credential_ranking_strategy",
    "version",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "organization_id": {"type": "string", "format": "uuid"},
    "name": {"type": "string", "minLength": 1, "maxLength": 255},
    "status": {
      "type": "string",
      "enum": ["draft", "active", "suspended", "archived"]
    },
    "description": {"type": "string", "maxLength": 2000},
    "purpose": {
      "type": "string",
      "maxLength": 2000,
      "description": "Human-readable consent description shown in the wallet UI during presentation request, e.g. 'Age verification for access control'"
    },
    "required_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_name"],
        "additionalProperties": false,
        "properties": {
          "claim_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "credential_type": {"type": "string"},
          "value_constraint": {},
          "predicate_spec": {
            "type": "object",
            "required": ["predicate_type", "params"],
            "additionalProperties": false,
            "properties": {
              "predicate_type": {
                "type": "string",
                "enum": ["RANGE_PROOF", "MEMBERSHIP", "EQUALITY", "NON_MEMBERSHIP", "INEQUALITY"]
              },
              "params": {"type": "object"},
              "supported_circuits": {
                "type": "array",
                "items": {"type": "string"}
              },
              "fallback_policy": {
                "type": "string",
                "enum": ["REQUIRE_PREDICATE", "ACCEPT_RAW", "DENY"]
              }
            }
          }
        }
      }
    },
    "accepted_credential_types": {
      "type": "array",
      "items": {"type": "string"}
    },
    "display_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "purpose",
        "verifier_name"
      ],
      "properties": {
        "title": {"type": "string", "maxLength": 255},
        "description": {"type": "string", "maxLength": 2000},
        "purpose": {
          "type": "string",
          "enum": [
            "identity_verification",
            "age_verification",
            "employment_verification",
            "address_verification",
            "qualification_verification",
            "authorization",
            "compliance",
            "other"
          ]
        },
        "purpose_description": {"type": ["string", "null"], "maxLength": 2000},
        "verifier_name": {"type": "string", "maxLength": 255},
        "verifier_logo_url": {"type": ["string", "null"], "format": "uri"},
        "privacy_policy_url": {"type": ["string", "null"], "format": "uri"},
        "terms_of_service_url": {"type": ["string", "null"], "format": "uri"}
      }
    },
    "credential_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "credential_template_id",
          "display_name",
          "required",
          "credential_payload_format",
          "requested_claims",
          "require_fresh_issuance"
        ],
        "properties": {
          "credential_template_id": {"type": "string", "minLength": 1},
          "display_name": {"type": "string", "maxLength": 255},
          "description": {"type": ["string", "null"], "maxLength": 2000},
          "required": {"type": "boolean"},
          "credential_payload_format": {"type": "string", "minLength": 1},
          "requested_claims": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "claim_name",
                "display_name",
                "required",
                "selective_disclosure",
                "accept_derived",
                "constraints"
              ],
              "properties": {
                "claim_name": {"type": "string", "minLength": 1},
                "display_name": {"type": "string", "maxLength": 255},
                "description": {"type": ["string", "null"], "maxLength": 2000},
                "required": {"type": "boolean"},
                "selective_disclosure": {"type": "boolean"},
                "accept_derived": {"type": "boolean"},
                "predicate_spec": {"type": ["object", "null"]},
                "constraints": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["claim_name", "constraint_type"],
                    "properties": {
                      "claim_name": {"type": "string", "minLength": 1},
                      "constraint_type": {
                        "type": "string",
                        "enum": [
                          "equals",
                          "not_equals",
                          "greater_than",
                          "less_than",
                          "greater_or_equal",
                          "less_or_equal",
                          "in_set",
                          "not_in_set",
                          "presence",
                          "regex",
                          "age_over"
                        ]
                      },
                      "value": {},
                      "description": {"type": ["string", "null"], "maxLength": 2000}
                    }
                  }
                }
              }
            }
          },
          "trust_profile_id": {"type": ["string", "null"]},
          "max_age_seconds": {"type": ["integer", "null"], "minimum": 1},
          "require_fresh_issuance": {"type": "boolean"}
        }
      }
    },
    "alternative_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "credential_requirements", "min_satisfied"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 255},
          "description": {"type": ["string", "null"], "maxLength": 2000},
          "credential_requirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "credential_template_id",
                "display_name",
                "required",
                "credential_payload_format",
                "requested_claims",
                "require_fresh_issuance"
              ],
              "properties": {
                "credential_template_id": {"type": "string", "minLength": 1},
                "display_name": {"type": "string", "maxLength": 255},
                "description": {"type": ["string", "null"], "maxLength": 2000},
                "required": {"type": "boolean"},
                "credential_payload_format": {"type": "string", "minLength": 1},
                "requested_claims": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "claim_name",
                      "display_name",
                      "required",
                      "selective_disclosure",
                      "accept_derived",
                      "constraints"
                    ],
                    "properties": {
                      "claim_name": {"type": "string", "minLength": 1},
                      "display_name": {"type": "string", "maxLength": 255},
                      "description": {"type": ["string", "null"], "maxLength": 2000},
                      "required": {"type": "boolean"},
                      "selective_disclosure": {"type": "boolean"},
                      "accept_derived": {"type": "boolean"},
                      "predicate_spec": {"type": ["object", "null"]},
                      "constraints": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["claim_name", "constraint_type"],
                          "properties": {
                            "claim_name": {"type": "string", "minLength": 1},
                            "constraint_type": {"type": "string"},
                            "value": {},
                            "description": {"type": ["string", "null"], "maxLength": 2000}
                          }
                        }
                      }
                    }
                  }
                },
                "trust_profile_id": {"type": ["string", "null"]},
                "max_age_seconds": {"type": ["integer", "null"], "minimum": 1},
                "require_fresh_issuance": {"type": "boolean"}
              }
            }
          },
          "min_satisfied": {"type": "integer", "minimum": 1}
        }
      }
    },
    "compliance_profile_id": {"type": ["string", "null"]},
    "trust_profile_id": {"type": ["string", "null"], "format": "uuid"},
    "holder_binding": {
      "type": "object",
      "required": ["required"],
      "additionalProperties": false,
      "properties": {
        "required": {"type": "boolean"},
        "binding_methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["CREDENTIAL_KEY", "DEVICE_KEY", "SESSION_BINDING"]},
          "description": "Control mechanism the verifier requires. Transaction freshness is configured separately in proof_freshness."
        },
        "proof_profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["OID4VP_VERIFIABLE_PRESENTATION", "SD_JWT_KEY_BINDING", "MDOC_DEVICE_AUTHENTICATION", "CUSTOM"]
          },
          "description": "Wire-level proof profiles accepted for the selected binding methods."
        },
        "proof_freshness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "challenge_required": {"type": "boolean", "default": true},
            "audience_binding_required": {"type": "boolean", "default": true},
            "replay_detection_required": {"type": "boolean", "default": true},
            "max_proof_age_seconds": {"type": "integer", "minimum": 1}
          },
          "description": "Challenge, audience, replay, and age checks applied to the authenticated holder proof."
        }
      },
      "allOf": [
        {
          "if": {"properties": {"required": {"const": true}}, "required": ["required"]},
          "then": {"required": ["binding_methods", "proof_profiles", "proof_freshness"]}
        },
        {
          "if": {"properties": {"required": {"const": false}}, "required": ["required"]},
          "then": {
            "not": {
              "anyOf": [
                {"required": ["binding_methods"]},
                {"required": ["proof_profiles"]},
                {"required": ["proof_freshness"]}
              ]
            }
          }
        }
      ]
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_age_seconds": {"type": "integer", "minimum": 1},
        "require_not_revoked": {"type": "boolean", "default": false},
        "revocation_grace_seconds": {"type": "integer", "minimum": 0}
      }
    },
    "prefer_predicates": {"type": "boolean", "default": false},
    "supported_circuits": {
      "type": "array",
      "items": {"type": "string"}
    },
    "fallback_policy": {
      "type": "string",
      "enum": ["REQUIRE_PREDICATE", "ACCEPT_RAW", "DENY"],
      "default": "ACCEPT_RAW"
    },
    "issuer_constraints": {
      "type": "object",
      "description": "Constraints on credential issuers enforced at verification time",
      "additionalProperties": false,
      "properties": {
        "min_trust_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Minimum TrustProfileIssuer.trust_level required. Credentials from issuers below this threshold are rejected."
        },
        "required_compliance_statuses": {
          "type": "array",
          "items": {"type": "string", "enum": ["ACCREDITED", "COMPLIANT"]},
          "description": "Issuer's IssuerEntity.compliance_status must be in this set"
        },
        "required_accreditations": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Issuer must hold all listed accreditations (e.g. ['ISO27001', 'FIPS140-2'])"
        }
      }
    },
    "credential_ranking_strategy": {
      "type": "string",
      "enum": ["FRESHEST_FIRST", "HIGHEST_TRUST_FIRST", "CUSTOM"],
      "default": "FRESHEST_FIRST",
      "description": "When a wallet holds multiple matching credentials, this determines which is preferred. FRESHEST_FIRST: most recently issued wins. HIGHEST_TRUST_FIRST: highest trust_level wins. CUSTOM: use credential_ranking_weights."
    },
    "credential_ranking_weights": {
      "type": ["object", "null"],
      "description": "Required when credential_ranking_strategy is CUSTOM. Maps ranking dimension to float weight.",
      "additionalProperties": {"type": "number"}
    },
    "version": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "anyOf": [
    {
      "required": ["required_claims"],
      "properties": {"required_claims": {"minItems": 1}}
    },
    {
      "required": ["credential_requirements"],
      "properties": {"credential_requirements": {"minItems": 1}}
    },
    {
      "required": ["alternative_requirements"],
      "properties": {"alternative_requirements": {"minItems": 1}}
    }
  ]
}
