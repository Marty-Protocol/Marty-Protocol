{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/marty-protocol/marty-protocol/main/schemas/organization-update-request.json",
  "title": "OrganizationUpdateRequest",
  "description": "Partially update an Organization through the public API. organization_id is required to bind the mutation to its tenant.",
  "type": "object",
  "required": ["organization_id"],
  "minProperties": 2,
  "additionalProperties": false,
  "properties": {
    "organization_id": {"type": "string", "format": "uuid"},
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
    },
    "display_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "description": {"type": ["string", "null"], "maxLength": 1024},
    "org_type": {
      "type": "string",
      "enum": ["enterprise", "startup", "individual", "government", "education", "healthcare", "financial", "other"]
    },
    "contact_email": {
      "oneOf": [
        {"type": "string", "format": "email", "maxLength": 255},
        {"type": "null"}
      ]
    },
    "contact_phone": {"type": ["string", "null"], "maxLength": 50},
    "website": {
      "oneOf": [
        {"type": "string", "format": "uri", "maxLength": 1024},
        {"type": "null"}
      ]
    },
    "visibility": {"type": "string", "enum": ["PUBLIC", "PRIVATE"]},
    "join_mechanism": {"type": "string", "enum": ["open", "code", "invite", "domain"]},
    "requires_approval": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"join_mechanism": {"const": "open"}},
        "required": ["join_mechanism"]
      },
      "then": {
        "properties": {"visibility": {"const": "PUBLIC"}},
        "required": ["visibility"]
      }
    }
  ]
}
