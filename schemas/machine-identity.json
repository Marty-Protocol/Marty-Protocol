{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/marty-protocol/marty-protocol/main/schemas/machine-identity.json",
  "title": "MachineIdentity",
  "description": "Managed identity and lifecycle record for a non-human secure runtime participating in identity or secure-document operations. This entity is not used for ordinary holder wallets and does not describe domain resources or execution controls.",
  "type": "object",
  "required": ["id", "organization_id", "machine_id", "display_name", "machine_type", "status", "identity_keys", "created_at"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "organization_id": {"type": "string", "format": "uuid"},
    "machine_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Stable organization-scoped machine identifier. It MAY be a URI, URN, certificate subject, DID, or operator-assigned identifier."
    },
    "display_name": {"type": "string", "minLength": 1, "maxLength": 256},
    "description": {"type": "string", "maxLength": 1024},
    "machine_type": {
      "type": "string",
      "enum": [
        "SECURE_DOCUMENT_PRINTER",
        "DOCUMENT_PERSONALIZATION_SYSTEM",
        "VERIFICATION_APPLIANCE",
        "WALLET_SECURE_ELEMENT",
        "HSM_WORKLOAD",
        "SECURE_PROCESSING_RUNTIME",
        "OTHER"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["PROVISIONED", "ACTIVE", "SUSPENDED", "REVOKED", "RETIRED"]
    },
    "identity_keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["key_id", "thumbprint", "algorithm", "status"],
        "additionalProperties": false,
        "properties": {
          "key_id": {"type": "string", "minLength": 1, "maxLength": 512},
          "thumbprint": {
            "type": "string",
            "pattern": "^sha256:[A-Za-z0-9_-]{32,}$",
            "description": "SHA-256 key or certificate thumbprint used to bind credentials, attestation, and authorization decisions to the same cryptographic identity."
          },
          "algorithm": {
            "type": "string",
            "enum": ["RS256", "RS384", "RS512", "ES256", "ES384", "ES512", "PS256", "PS384", "PS512", "EdDSA", "Ed25519", "Ed448"]
          },
          "public_key_jwk": {"type": "object", "minProperties": 1},
          "certificate_chain_ref": {"type": "string", "format": "uri"},
          "status": {"type": "string", "enum": ["ACTIVE", "ROTATING", "REVOKED", "EXPIRED"]},
          "valid_from": {"type": ["string", "null"], "format": "date-time"},
          "valid_until": {"type": ["string", "null"], "format": "date-time"}
        },
        "anyOf": [
          {"required": ["public_key_jwk"]},
          {"required": ["certificate_chain_ref"]}
        ]
      }
    },
    "assignments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deployment_profile_id": {"type": ["string", "null"], "format": "uuid"},
        "site_id": {"type": ["string", "null"], "maxLength": 256},
        "operator_organization_id": {"type": ["string", "null"], "format": "uuid"}
      }
    },
    "credential_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 512},
      "uniqueItems": true,
      "description": "Identifiers of credentials that certify ownership, deployment assignment, manufacturer endorsement, or another identity property of this machine."
    },
    "attestation_identity": {
      "type": "object",
      "description": "Identifiers and formats the machine can use to produce attestation evidence. Acceptance requirements belong to MachineAuthenticationPolicy.",
      "additionalProperties": false,
      "properties": {
        "attestation_key_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 512},
          "uniqueItems": true
        },
        "evidence_formats": {
          "type": "array",
          "items": {"type": "string", "enum": ["EAT", "TPM_QUOTE", "PLATFORM_ATTESTATION", "CUSTOM"]},
          "uniqueItems": true
        },
        "endorsement_refs": {
          "type": "array",
          "items": {"type": "string", "format": "uri"},
          "uniqueItems": true
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "suspended_at": {"type": ["string", "null"], "format": "date-time"},
    "revoked_at": {"type": ["string", "null"], "format": "date-time"},
    "retired_at": {"type": ["string", "null"], "format": "date-time"},
    "status_reason": {"type": ["string", "null"], "maxLength": 512}
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "ACTIVE"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "identity_keys": {
            "contains": {
              "type": "object",
              "properties": {"status": {"const": "ACTIVE"}},
              "required": ["status"]
            },
            "minContains": 1,
            "maxContains": 1
          }
        }
      }
    }
  ]
}
