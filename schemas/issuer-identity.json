{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/marty-protocol/marty-protocol/main/schemas/issuer-identity.json",
  "title": "IssuerIdentity",
  "description": "A tenant-scoped public DID projection that callers may select for issuance or signed verification. Custody coordinates and internal issuer-profile IDs are never part of this resource.",
  "type": "object",
  "required": ["issuer_did", "key_purpose", "credential_format", "algorithm", "status"],
  "additionalProperties": false,
  "properties": {
    "issuer_did": {"type": "string", "pattern": "^did:", "maxLength": 2048},
    "key_purpose": {
      "type": "string",
      "enum": [
        "vc_jwt_issuer",
        "mdoc_dsc",
        "x509_doc_signer",
        "holder_binding",
        "presentation_signing",
        "oid4vp_request_signing",
        "vdsnc_signing",
        "csca",
        "jwks_signing",
        "lti_tool_signing"
      ]
    },
    "credential_format": {"$ref": "../enums/credential-formats.json"},
    "algorithm": {
      "type": "string",
      "enum": ["ES256", "ES384", "RS256", "EdDSA"]
    },
    "status": {"type": "string", "enum": ["active"]}
  }
}
