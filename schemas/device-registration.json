{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/marty-protocol/marty-protocol/main/schemas/device-registration.json",
  "title": "DeviceRegistration",
  "description": "User device record for push notification delivery and challenge-response authentication",
  "type": "object",
  "required": ["user_id", "device_id", "platform", "fcm_token", "is_active", "created_at"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "user_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "organization_id": {"type": ["string", "null"], "format": "uuid"},
    "device_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "platform": {
      "type": "string",
      "enum": ["ios", "android", "web"]
    },
    "fcm_token": {"type": "string", "minLength": 1},
    "app_version": {"type": "string"},
    "os_version": {"type": "string"},
    "device_model": {"type": "string"},
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "credential_notifications": {"type": "boolean", "default": true},
        "verification_notifications": {"type": "boolean", "default": true},
        "system_notifications": {"type": "boolean", "default": true},
        "quiet_hours_start": {"type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
        "quiet_hours_end": {"type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"}
      }
    },
    "public_key_der": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "contentEncoding": "base64url",
      "description": "Base64url-encoded current RSA public key in PKCS#1 DER format"
    },
    "public_key_kid": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "SHA-256 JWK Thumbprint of the current public key per RFC 7638"
    },
    "key_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Monotonic server-assigned current-key version, bounded to the cross-language exact-integer range"
    },
    "key_valid_from": {
      "type": "string",
      "format": "date-time",
      "description": "Server-assigned activation time of the current key"
    },
    "key_valid_until": {
      "type": "string",
      "format": "date-time",
      "description": "Server-assigned absolute expiry of the current key; never an old-key rotation grace deadline"
    },
    "is_active": {"type": "boolean"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "last_seen_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {
        "required": ["public_key_der"]
      },
      "then": {
        "required": ["public_key_kid"]
      }
    },
    {
      "if": {
        "anyOf": [
          {"required": ["key_version"]},
          {"required": ["key_valid_from"]},
          {"required": ["key_valid_until"]}
        ]
      },
      "then": {
        "required": ["public_key_der", "public_key_kid"]
      }
    }
  ]
}
