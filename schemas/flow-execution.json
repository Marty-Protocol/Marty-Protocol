{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/marty-protocol/marty-protocol/main/schemas/flow-execution.json",
  "title": "FlowExecution",
  "description": "Public, tenant-scoped projection of a single Flow execution. Internal custody selectors, bearer credentials, pre-authorized codes, and service state are never part of this representation.",
  "type": "object",
  "required": ["id", "flow_id", "flow_type", "organization_id", "status", "context_data", "step_results", "metadata", "state_history", "created_at", "updated_at"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1, "maxLength": 255},
    "flow_id": {
      "type": ["string", "null"],
      "maxLength": 255,
      "description": "References Flow.id. Null only for a supported system-defined verification flow."
    },
    "flow_type": {
      "oneOf": [
        {"$ref": "../enums/flow-types.json"},
        {"type": "null"}
      ],
      "description": "Copied from the Flow definition at instantiation time."
    },
    "organization_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "status": {"$ref": "../enums/flow-statuses.json"},
    "current_step": {"type": ["string", "null"], "maxLength": 255},
    "current_step_index": {"type": ["integer", "null"], "minimum": 0},
    "step_results": {
      "type": "object",
      "propertyNames": {"minLength": 1, "maxLength": 255},
      "additionalProperties": {
        "type": "object",
        "required": ["result"],
        "additionalProperties": false,
        "properties": {
          "result": {"$ref": "#/$defs/publicValue"},
          "completed_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "context_data": {"$ref": "#/$defs/publicObject"},
    "issued_credential_id": {"type": ["string", "null"], "maxLength": 255},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "error_code": {"type": ["string", "null"], "maxLength": 255},
    "metadata": {"$ref": "#/$defs/publicObject"},
    "state_history": {
      "type": "array",
      "items": {"$ref": "#/$defs/publicObject"}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "forbiddenPropertyName": {
      "enum": [
        "issuer_profile_id",
        "issuer_key_id",
        "issuer_algorithm",
        "key_access_mode",
        "verification_method_id",
        "signing_service_id",
        "signing_key_reference",
        "key_reference",
        "kms_provider",
        "provider",
        "key_name",
        "key_version",
        "transit_mount",
        "pre_auth_code",
        "pre_authorized_code",
        "pre-authorized_code",
        "access_token",
        "refresh_token",
        "client_secret",
        "private_key",
        "private_key_jwk",
        "session_token",
        "api_key"
      ]
    },
    "publicObject": {
      "type": "object",
      "propertyNames": {"not": {"$ref": "#/$defs/forbiddenPropertyName"}},
      "additionalProperties": {"$ref": "#/$defs/publicValue"}
    },
    "publicValue": {
      "anyOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "number"},
        {"type": "string"},
        {"type": "array", "items": {"$ref": "#/$defs/publicValue"}},
        {"$ref": "#/$defs/publicObject"}
      ]
    }
  }
}
