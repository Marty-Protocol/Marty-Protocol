{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/marty-protocol/marty-protocol/main/schemas/applicant.json",
  "title": "ApplicantApplication",
  "description": "A holder-owned credential application created from an active ApplicationTemplate. Identity, credential policy, checks, and issuer data are server-derived.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "applicant_id",
    "organization_id",
    "application_template_id",
    "credential_template_id",
    "form_data",
    "integration_context",
    "status",
    "claim_state",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "applicant_id": {
      "type": "string",
      "format": "uuid",
      "description": "Server-derived holder profile identifier. Clients MUST NOT supply this on creation."
    },
    "organization_id": {"type": "string", "format": "uuid"},
    "reference_number": {"type": ["string", "null"], "maxLength": 128},
    "application_template_id": {"type": "string", "format": "uuid"},
    "credential_template_id": {
      "type": "string",
      "format": "uuid",
      "description": "Resolved from application_template_id by the server."
    },
    "form_data": {
      "type": "object",
      "description": "Applicant-supplied values validated against the active ApplicationTemplate.",
      "additionalProperties": true
    },
    "integration_context": {
      "type": "object",
      "description": "Non-claim integration correlation data. It MUST NOT be copied into credential claims.",
      "additionalProperties": true
    },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "SUBMITTED", "UNDER_REVIEW", "PENDING_INFORMATION", "APPROVED", "REJECTED", "WITHDRAWN", "OFFERED", "CREDENTIALED", "SUSPENDED"]
    },
    "claim_state": {
      "type": "string",
      "enum": ["NOT_READY", "BLOCKED", "OFFER_READY", "CLAIMED", "EXPIRED"]
    },
    "claim_blocker": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "owner", "message"],
          "properties": {
            "code": {"type": "string", "maxLength": 128},
            "owner": {"type": "string", "enum": ["APPLICANT", "ISSUER", "SYSTEM"]},
            "message": {"type": "string", "maxLength": 512}
          }
        }
      ]
    },
    "credential_display_name": {"type": ["string", "null"], "maxLength": 256},
    "credential_offer_uri": {"type": ["string", "null"]},
    "credential_offer_uris": {"type": "object", "additionalProperties": {"type": "string"}},
    "credential_offer_labels": {"type": "object", "additionalProperties": {"type": "string"}},
    "offer_expires_at": {"type": ["string", "null"], "format": "date-time"},
    "submitted_at": {"type": ["string", "null"], "format": "date-time"},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "issued_at": {"type": ["string", "null"], "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
