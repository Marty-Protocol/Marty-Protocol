{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/marty-protocol/marty-protocol/main/schemas/verification-reducer-reference.json",
  "title": "VerificationReducerReference",
  "description": "Pure reducer contract that derived the verification decision",
  "type": "object",
