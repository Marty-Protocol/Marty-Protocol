{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/marty-protocol/marty-protocol/main/schemas/trust-profile.json",
  "title": "TrustProfile",
  "description": "Cryptographic trust configuration for credential issuance and verification. Used by both issuance flows (which issuer keys are trusted) and verification flows (which credential issuers/roots are accepted). For org-specific framework overrides, see OrganizationTrustProfile.",
  "type": "object",
  "required": ["id", "organization_id", "name", "status", "profile_type", "trust_sources", "allowed_algorithms", "compliance_status", "created_at"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "organization_id": {"type": "string", "format": "uuid"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "description": {"type": "string", "maxLength": 1024},
    "status": {"$ref": "../enums/trust-profile-statuses.json"},
    "profile_type": {
      "type": "string",
      "enum": ["ICAO", "AAMVA", "EUDI", "CUSTOM"],
      "description": "Top-level framework classification. Determines default trust anchors, certificate chain validation rules, and which PKD endpoints to consult."
    },
    "trust_purposes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "CREDENTIAL_ISSUER",
          "MACHINE_IDENTITY_CA",
          "MANUFACTURER_ENDORSER",
          "ATTESTATION_VERIFIER",
          "DEPLOYMENT_AUTHORITY",
          "EVIDENCE_SIGNER"
        ]
      },
      "uniqueItems": true,
      "description": "Roles for which this trust profile may be used. Absent means the legacy CREDENTIAL_ISSUER purpose only."
    },
    "trust_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_type"],
        "additionalProperties": false,
        "properties": {
          "source_type": {"type": "string", "enum": ["TRUST_LIST", "PINNED_ISSUER", "ROOT_CA", "PKD_URL"]},
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "allOf": [
              {"not": {"pattern": "^https://[^/?#]*@"}},
              {"not": {"pattern": "[?#]"}},
              {"not": {"pattern": "^https://(?:\\[[^]]+\\]|[^/:?#]+):(?!443(?:/|$))[0-9]+(?:/|$)"}}
            ],
            "description": "HTTPS URI for a trust list or a pinned issuer URL. Pinned issuer URLs are useful for web-native badge ecosystems such as Canvas Credentials or Open Badges."
          },
          "certificate_pem": {"type": "string", "pattern": "^-----BEGIN CERTIFICATE-----"},
          "issuer_did": {"type": "string", "pattern": "^did:"},
          "organization_id": {
            "type": "string",
            "description": "Optional organization scope for DID issuer resolution. When present, verifiers MUST resolve issuer_did through that organization's issuer identity registry before public DID fallback."
          },
          "verification_method_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^did:.+#.+"},
            "uniqueItems": true,
            "description": "Optional pinned DID verification method IDs accepted for this issuer DID."
          },
          "did_resolution": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "resolver_type": {
                "type": "string",
                "enum": ["ORGANIZATION_REGISTRY", "PUBLIC_DID", "ORGANIZATION_REGISTRY_WITH_PUBLIC_FALLBACK"],
                "default": "ORGANIZATION_REGISTRY"
              },
              "allow_public_fallback": {"type": "boolean", "default": false},
              "cache_ttl_seconds": {"type": "integer", "minimum": 0, "default": 300}
            },
            "description": "DID resolution policy for DID-backed trust sources. The default is fail-closed org-scoped resolution."
          },
          "purposes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "CREDENTIAL_ISSUER",
                "MACHINE_IDENTITY_CA",
                "MANUFACTURER_ENDORSER",
                "ATTESTATION_VERIFIER",
                "DEPLOYMENT_AUTHORITY",
                "EVIDENCE_SIGNER"
              ]
            },
            "uniqueItems": true,
            "description": "Optional narrowing of the profile-level trust purposes for this source."
          },
          "description": {"type": "string", "maxLength": 256},
          "registry_sync": {
            "type": "object",
            "description": "Optional pull configuration for an external registry that implements the Marty Trust Registry Sync v1 contract. This does not imply support for a registry's native/raw distribution format.",
            "required": ["protocol", "refresh_interval_hours"],
            "additionalProperties": false,
            "properties": {
              "protocol": {
                "type": "string",
                "const": "MARTY_TRUST_REGISTRY_SYNC_V1"
              },
              "refresh_interval_hours": {
                "type": "integer",
                "minimum": 1,
                "maximum": 720,
                "default": 24
              }
            }
          }
        },
        "oneOf": [
          {"required": ["url"]},
          {"required": ["certificate_pem"]},
          {"required": ["issuer_did"]}
        ],
        "allOf": [
          {
            "if": {"required": ["registry_sync"]},
            "then": {
              "required": ["url"],
              "properties": {
                "source_type": {"enum": ["TRUST_LIST", "PKD_URL"]}
              }
            }
          },
          {
            "if": {
              "required": ["url"],
              "properties": {
                "source_type": {"enum": ["TRUST_LIST", "PKD_URL"]}
              }
            },
            "then": {"required": ["registry_sync"]}
          }
        ]
      }
    },
    "allowed_algorithms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["RS256", "RS384", "RS512", "ES256", "ES384", "ES512", "PS256", "PS384", "PS512", "EdDSA", "Ed25519", "Ed448"]
      },
      "uniqueItems": true
    },
    "revocation_policy": {
      "type": "object",
      "description": "Revocation checking configuration",
      "additionalProperties": false,
      "properties": {
        "check_mode": {
          "type": "string",
          "enum": ["HARD_FAIL", "SOFT_FAIL", "SKIP"],
          "default": "HARD_FAIL",
          "description": "HARD_FAIL: reject credential if revocation check fails or is unavailable. SOFT_FAIL: accept with warning if check fails. SKIP: bypass revocation check entirely."
        },
        "cache_ttl_seconds": {"type": "integer", "minimum": 0, "default": 300}
      }
    },
    "revocation_services": {
      "type": "object",
      "description": "Revocation endpoint configuration for CRL, OCSP, and status list methods",
      "additionalProperties": false,
      "properties": {
        "enabled_methods": {
          "type": "array",
          "items": {"type": "string", "enum": ["CRL", "OCSP", "STATUS_LIST"]},
          "uniqueItems": true
        },
        "auto_discover": {
          "type": "boolean",
          "default": false,
          "description": "Attempt to discover revocation endpoints from credential metadata"
        },
        "merge_discovered": {
          "type": "boolean",
          "default": false,
          "description": "Merge auto-discovered endpoints with explicitly configured ones"
        },
        "crl_endpoints": {"type": "array", "items": {"type": "string", "format": "uri"}},
        "ocsp_urls": {"type": "array", "items": {"type": "string", "format": "uri"}},
        "status_list_urls": {"type": "array", "items": {"type": "string", "format": "uri"}}
      }
    },
    "time_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clock_skew_seconds": {"type": "integer", "minimum": 0, "maximum": 3600, "default": 300},
        "max_credential_age_seconds": {"type": ["integer", "null"], "minimum": 1},
        "require_freshness": {"type": "boolean", "default": false},
        "freshness_window_seconds": {"type": ["integer", "null"], "minimum": 1}
      },
      "if": {"properties": {"require_freshness": {"const": true}}},
      "then": {"required": ["freshness_window_seconds"], "properties": {"freshness_window_seconds": {"type": "integer"}}}
    },
    "supported_formats": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "../enums/credential-formats.json"},
      "uniqueItems": true
    },
    "trusted_assertion_formats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["X509_CERTIFICATE", "EAT", "TPM_QUOTE", "JWT", "CWT", "CUSTOM"]
      },
      "uniqueItems": true,
      "description": "Non-credential assertion formats accepted for machine identity, manufacturer endorsement, attestation, deployment authority, or evidence signing."
    },
    "allowed_issuers": {
      "type": ["array", "null"],
      "items": {"type": "string"},
      "uniqueItems": true,
      "description": "Explicit issuer allowlist. Each entry MAY be a DID, HTTPS issuer URL, or issuer domain. Verifiers SHOULD match exact identifiers and normalized URL/domain aliases. null = allow all not in denied_issuers."
    },
    "denied_issuers": {
      "type": ["array", "null"],
      "items": {"type": "string"},
      "uniqueItems": true,
      "description": "Explicit issuer denylist. Each entry MAY be a DID, HTTPS issuer URL, or issuer domain. Checked before allowed_issuers."
    },
    "system_issuer_overrides": {
      "type": "object",
      "description": "Per-issuer overrides for system issuers (e.g. ICAO-enrolled states). Keyed by issuer_id.",
      "additionalProperties": {
        "type": "object",
        "required": ["action"],
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string",
            "enum": ["DENY", "DOWNGRADE"],
            "description": "DENY: reject credentials from this issuer even though it's a trusted system issuer. DOWNGRADE: reduce trust_level for credentials from this issuer."
          },
          "trust_level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Required when action is DOWNGRADE. Sets an effective trust level below the default 100."
          },
          "reason": {"type": "string", "maxLength": 512}
        }
      }
    },
    "compliance_status": {
      "type": "string",
      "enum": ["COMPLIANT", "NEEDS_ATTENTION", "SETUP_REQUIRED"],
      "default": "SETUP_REQUIRED"
    },
    "revocation_profile_id": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "Optional reference to a RevocationProfile entity that governs revocation check mode, caching, and grace period. When set, takes precedence over inline revocation_policy configuration."
    },
    "verification_policy_set_id": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "Reference to a PolicySet (policy_type=CREDENTIAL_VERIFICATION) containing Cedar policies for issuer trust decisions. When set, Cedar policies augment the allowed_issuers/denied_issuers lists: Cedar forbid policies act as an additional deny layer, and Cedar permit policies can grant access to issuers not in allowed_issuers."
    },
    "compatible_compliance_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["ICAO_DTC", "ICAO_MRZ", "ICAO_PASSPORT", "AAMVA_MDL", "EUDI_PID", "EUDI_MDL", "OB3_JWT", "OB3_JSONLD", "SD_JWT_VC", "ENTERPRISE_VC", "OID4VC", "PEX", "CUSTOM"]
      },
      "uniqueItems": true,
      "description": "Compliance codes whose trust requirements this profile satisfies. Enables multiple compliance profiles (e.g., EUDI_PID and EUDI_MDL) to share a single EUDI trust registry. When null or absent, compatibility is inferred from profile_type alone."
    },
    "auto_generated": {"type": "boolean", "default": false},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {"not": {"required": ["trust_purposes"]}},
          {
            "properties": {
              "trust_purposes": {"contains": {"const": "CREDENTIAL_ISSUER"}}
            },
            "required": ["trust_purposes"]
          }
        ]
      },
      "then": {"required": ["supported_formats"]}
    },
    {
      "if": {
        "properties": {
          "trust_purposes": {
            "contains": {
              "enum": [
                "MACHINE_IDENTITY_CA",
                "MANUFACTURER_ENDORSER",
                "ATTESTATION_VERIFIER",
                "DEPLOYMENT_AUTHORITY",
                "EVIDENCE_SIGNER"
              ]
            }
          }
        },
        "required": ["trust_purposes"]
      },
      "then": {"required": ["trusted_assertion_formats"]}
    }
  ]
}
