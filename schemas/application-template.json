{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/marty-protocol/marty-protocol/main/schemas/application-template.json",
  "title": "ApplicationTemplate",
  "description": "User-facing credential application workflow with form fields, evidence, and approval config",
  "type": "object",
  "required": ["id", "organization_id", "name", "approval_strategy", "status", "created_at"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "organization_id": {"type": "string", "format": "uuid"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "description": {"type": "string", "maxLength": 1024},
    "form_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field_id", "label", "field_type", "required"],
        "additionalProperties": false,
        "properties": {
          "field_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "label": {"type": "string", "minLength": 1, "maxLength": 256},
          "field_type": {"type": "string", "enum": ["TEXT", "DATE", "SELECT", "FILE_UPLOAD", "BOOLEAN"]},
          "required": {"type": "boolean"},
          "claim_mapping": {"type": "string"},
          "validation_pattern": {"type": "string"},
          "options": {"type": "array", "items": {"type": "string"}},
          "placeholder": {"type": "string"},
          "hint": {"type": "string"}
        }
      }
    },
    "evidence_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "evidence_type", "description", "required"],
        "additionalProperties": false,
        "properties": {
          "evidence_id": {"type": "string"},
          "evidence_type": {"type": "string", "enum": ["DOCUMENT_SCAN", "BIOMETRIC", "SELFIE", "THIRD_PARTY_VERIFICATION", "EXTERNAL_FACT", "EXTERNAL_API"]},
          "description": {"type": "string"},
          "required": {"type": "boolean"},
          "accepted_formats": {"type": "array", "items": {"type": "string"}},
          "max_file_size_bytes": {"type": "integer", "minimum": 1},
          "provider": {
            "type": "string",
            "description": "Provider namespace expected to produce the fact, for example canvas."
          },
          "fact_type": {
            "type": "string",
            "description": "Normalized fact type required by policy, for example canvas.course_completion."
          },
          "scope": {
            "type": "object",
            "description": "Required fact scope keys such as course_id, assignment_id, quiz_id, or module_id."
          },
          "pass_rule": {
            "type": "object",
            "description": "Optional provider-neutral pass rule evaluated by the fact layer before policy context is built."
          },
          "verification_method": {
            "type": "string",
            "description": "Expected verification method, for example SIGNED_WEBHOOK, REST_PULL, LTI_CLAIM, or INSTRUCTOR_APPROVAL."
          },
          "freshness": {
            "type": "object",
            "description": "Optional freshness constraints for when the fact was created or verified."
          },
          "manual_fallback": {
            "type": "boolean",
            "description": "Whether this requirement may be satisfied by manual review if provider evidence is unavailable."
          },
          "api": {
            "type": "object",
            "description": "Declarative HTTP API call used to create this evidence fact when no custom adapter is required.",
            "additionalProperties": false,
            "properties": {
              "method": {"type": "string", "enum": ["GET", "POST", "PUT", "PATCH"]},
              "url": {"type": "string", "format": "uri"},
              "timeout_seconds": {"type": "number", "minimum": 1, "maximum": 20},
              "headers": {"type": "object"},
              "secret_headers": {
                "type": "object",
                "description": "Header name to deployment secret/env-var name mappings. Secret values are resolved at runtime and are not stored in facts."
              },
              "params": {"type": "object"},
              "body": {},
              "json": {},
              "allow_private_network": {"type": "boolean"}
            }
          },
          "expected_response": {
            "type": "object",
            "description": "Expected HTTP status codes and JSON/path conditions that must hold before the response is treated as verified.",
            "properties": {
              "status_codes": {"type": "array", "items": {"type": "integer"}},
              "json": {"type": "object"},
              "conditions": {"type": "object"},
              "body": {"type": "object"}
            }
          },
          "response_mapping": {
            "type": "object",
            "description": "Mapping from the provider response into EvidenceFact provider, fact_type, subject_id, scope, assertion, verification, and source metadata.",
            "properties": {
              "provider": {},
              "fact_type": {},
              "subject_id": {},
              "subject_id_path": {"type": "string"},
              "provider_event_id": {},
              "provider_event_id_path": {"type": "string"},
              "source_event_id_path": {"type": "string"},
              "verification_status_path": {"type": "string"},
              "verification_verified_values": {"type": "array"},
              "scope": {"type": "object"},
              "assertion": {"type": "object"},
              "assertions": {"type": "object"}
            }
          },
          "auto_approve_on_evidence": {
            "type": "boolean",
            "description": "Whether a permit decision may automatically approve and issue after this requirement is satisfied."
          },
          "auto_issue_on_permit": {
            "type": "boolean",
            "description": "Alias for auto_approve_on_evidence used by generic external API checks."
          }
        }
      }
    },
    "claim_collection_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_name", "source"],
        "properties": {
          "claim_name": {"type": "string"},
          "source": {"type": "string", "enum": ["FORM_FIELD", "EVIDENCE_EXTRACTION", "EXTERNAL_API", "SYSTEM"]},
          "source_config": {"type": "object"}
        }
      }
    },
    "approval_strategy": {
      "type": "string",
      "enum": ["AUTO", "MANUAL", "RULES_BASED", "EXTERNAL"]
    },
    "approval_rules": {
      "type": "object",
      "description": "DEPRECATED: Use approval_policy_set_id with Cedar policies instead. Legacy opaque rules object for RULES_BASED approval."
    },
    "approval_policy_set_id": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "Reference to a PolicySet (policy_type=APPROVAL_RULES) containing Cedar policies that govern auto-approval, manual review triggers, and denial rules. Required when approval_strategy = RULES_BASED. When set, takes precedence over legacy approval_rules."
    },
    "notification_config": {"type": "object"},
    "ui_config": {"type": "object"},
    "status": {"type": "string", "enum": ["DRAFT", "ACTIVE", "DEPRECATED"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
