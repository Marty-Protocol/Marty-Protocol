{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/marty-protocol/marty-protocol/main/schemas/flow.json",
  "title": "Flow",
  "description": "End-to-end identity lifecycle orchestration. Standard FlowTypes have fixed protocol sequences; non-standard graphs use flow_type custom with a versioned extension envelope.",
  "type": "object",
  "required": ["id", "organization_id", "name", "flow_type", "approval_strategy", "status", "created_at"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "organization_id": {"type": "string", "format": "uuid"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "description": {"type": "string", "maxLength": 1024},
    "flow_type": {"$ref": "../enums/flow-types.json"},
    "flow_category": {
      "type": "string",
      "enum": ["ISSUANCE", "VERIFICATION", "RENEWAL", "REVOCATION", "COMBINED"],
      "readOnly": true,
      "description": "Derived from flow_type or, for custom flows, extension.extends_flow_type."
    },
    "trust_profile_id": {"type": ["string", "null"], "format": "uuid"},
    "credential_template_id": {"type": ["string", "null"], "format": "uuid"},
    "application_template_id": {"type": ["string", "null"], "format": "uuid"},
    "presentation_policy_id": {"type": ["string", "null"], "format": "uuid"},
    "delivery_destination_profile_id": {"type": ["string", "null"], "maxLength": 128},
    "deployment_profile_ids": {
      "type": "array",
      "items": {"type": "string", "format": "uuid"},
      "uniqueItems": true
    },
    "approval_strategy": {"$ref": "../enums/approval-strategies.json"},
    "hooks": {
      "type": "object",
      "description": "Hooks keyed by pre_{step_name} or post_{step_name}. Standard flows accept hooks only on extensible steps declared by their FlowType.",
      "propertyNames": {"pattern": "^(pre|post)_[a-z][a-z0-9_]*$"},
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["hook_type"],
          "additionalProperties": false,
          "properties": {
            "hook_type": {"type": "string", "enum": ["WEBHOOK", "EXTERNAL_API", "SCRIPT"]},
            "url": {"type": "string", "format": "uri"},
            "config": {"type": "object"}
          }
        }
      }
    },
    "trigger": {
      "type": "object",
      "required": ["trigger_type"],
      "additionalProperties": false,
      "properties": {
        "trigger_type": {"type": "string", "enum": ["API_CALL", "WEBHOOK", "SCHEDULE", "APPLICATION_SUBMITTED"]},
        "config": {"type": "object"}
      }
    },
    "extension": {"$ref": "flow-extension.json"},
    "status": {"type": "string", "enum": ["DRAFT", "ACTIVE", "PAUSED", "ARCHIVED"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"flow_type": {"enum": ["oid4vci_pre_authorized", "oid4vci_authorization_code", "mdl_issuance", "credential_renewal", "credential_revocation"]}}, "required": ["flow_type"]},
      "then": {"required": ["credential_template_id"], "properties": {"credential_template_id": {"type": "string", "format": "uuid"}}}
    },
    {
      "if": {"properties": {"flow_type": {"const": "application_approval_issuance"}}, "required": ["flow_type"]},
      "then": {
        "required": ["application_template_id"],
        "properties": {"application_template_id": {"type": "string", "format": "uuid"}},
        "not": {"required": ["credential_template_id"], "properties": {"credential_template_id": {"type": "string"}}}
      }
    },
    {
      "if": {"properties": {"flow_type": {"enum": ["oid4vp_presentation", "mdl_presentation", "siopv2"]}}, "required": ["flow_type"]},
      "then": {"required": ["presentation_policy_id"], "properties": {"presentation_policy_id": {"type": "string", "format": "uuid"}}}
    },
    {
      "if": {"properties": {"flow_type": {"const": "combined"}}, "required": ["flow_type"]},
      "then": {
        "required": ["credential_template_id", "presentation_policy_id"],
        "properties": {
          "credential_template_id": {"type": "string", "format": "uuid"},
          "presentation_policy_id": {"type": "string", "format": "uuid"}
        }
      }
    },
    {
      "if": {"properties": {"flow_type": {"const": "physical_document_issuance"}}, "required": ["flow_type"]},
      "then": {
        "required": ["credential_template_id", "application_template_id", "delivery_destination_profile_id"],
        "properties": {
          "credential_template_id": {"type": "string", "format": "uuid"},
          "application_template_id": {"type": "string", "format": "uuid"},
          "delivery_destination_profile_id": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    },
    {
      "if": {"properties": {"flow_type": {"const": "custom"}}, "required": ["flow_type"]},
      "then": {"required": ["extension"]},
      "else": {"not": {"required": ["extension"]}}
    }
  ]
}
