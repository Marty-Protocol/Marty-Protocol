{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/marty-protocol/marty-protocol/main/schemas/organization.json",
  "title": "Organization",
  "description": "The primary multi-tenant boundary in MIP. All configuration resources are scoped to an organization.",
  "type": "object",
  "required": [
    "id",
    "name",
    "display_name",
    "visibility",
    "owner_id",
    "status",
    "org_type",
    "join_mechanism",
    "requires_approval",
    "is_discoverable",
    "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
      "description": "Machine-friendly slug. Must be globally unique (case-insensitive)."
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {"type": ["string", "null"], "maxLength": 1024},
    "join_code": {
      "type": ["string", "null"],
      "minLength": 6,
      "maxLength": 16,
      "pattern": "^[A-Z0-9]{6,16}$",
      "description": "Alphanumeric code for joining organizations that use code-based admission."
    },
    "visibility": {
      "type": "string",
      "enum": ["PUBLIC", "PRIVATE"],
      "description": "PUBLIC organizations are discoverable. PRIVATE organizations require a direct admission mechanism."
    },
    "owner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "description": "User ID of the current organization owner. Must be an active member."
    },
    "status": {
      "type": "string",
      "enum": ["active", "suspended", "pending"]
    },
    "org_type": {
      "type": "string",
      "enum": [
        "enterprise",
        "startup",
        "individual",
        "government",
        "education",
        "healthcare",
        "financial",
        "other"
      ]
    },
    "join_mechanism": {
      "type": "string",
      "enum": ["open", "code", "invite", "domain"]
    },
    "requires_approval": {"type": "boolean"},
    "is_discoverable": {"type": "boolean", "readOnly": true},
    "contact_email": {
      "oneOf": [
        {"type": "string", "format": "email", "maxLength": 255},
        {"type": "null"}
      ]
    },
    "contact_phone": {"type": ["string", "null"], "maxLength": 50},
    "website": {
      "oneOf": [
        {"type": "string", "format": "uri", "maxLength": 1024},
        {"type": "null"}
      ]
    },
    "membership": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "roles",
            "status",
            "permissions",
            "has_org_console_access",
            "is_owner",
            "joined_at"
          ],
          "additionalProperties": false,
          "properties": {
            "roles": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "name", "display_name"],
                "additionalProperties": false,
                "properties": {
                  "id": {"type": "string", "minLength": 1},
                  "name": {"type": "string", "minLength": 1},
                  "display_name": {"type": ["string", "null"]}
                }
              }
            },
            "status": {
              "type": "string",
              "enum": ["active", "pending", "invited", "deactivated"]
            },
            "permissions": {
              "type": "array",
              "items": {"type": "string"},
              "uniqueItems": true
            },
            "has_org_console_access": {"type": "boolean"},
            "is_owner": {"type": "boolean"},
            "joined_at": {"type": ["string", "null"], "format": "date-time"}
          }
        },
        {"type": "null"}
      ]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"visibility": {"const": "PUBLIC"}},
        "required": ["visibility"]
      },
      "then": {
        "properties": {"is_discoverable": {"const": true}}
      },
      "else": {
        "properties": {"is_discoverable": {"const": false}}
      }
    }
  ]
}
