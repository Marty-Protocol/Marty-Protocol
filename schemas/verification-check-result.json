{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/marty-protocol/marty-protocol/main/schemas/verification-check-result.json",
  "title": "VerificationCheckResult",
  "description": "Privacy-minimized evidence outcome for one verification check",
  "type": "object",
  "required": ["check_id", "category", "required", "outcome", "code", "component_id", "evaluated_at", "evidence_refs"],
  "additionalProperties": false,
  "properties": {
    "check_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "category": {"$ref": "../enums/verification-check-categories.json"},
    "required": {"type": "boolean"},
    "outcome": {"$ref": "../enums/verification-check-outcomes.json"},
    "code": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
    },
    "safe_message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$",
      "description": "Bounded operator-safe text without control characters, claim values, or adapter exception content"
    },
    "component_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9._-]*$",
      "description": "Identifier of exactly one component declared by the enclosing canonical result; multiple checks may reference that component"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "Canonical RFC 3339 UTC timestamp no later than the enclosing result evaluated_at"
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 20,
        "maxLength": 224,
        "pattern": "^urn:marty:evidence:[A-Za-z0-9][A-Za-z0-9._:/-]+$"
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"enum": ["PASSED", "FAILED"]}}, "required": ["outcome"]},
      "then": {"properties": {"evidence_refs": {"minItems": 1}}}
    }
  ]
}
