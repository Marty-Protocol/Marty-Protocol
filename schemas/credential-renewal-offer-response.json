{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/marty-protocol/marty-protocol/main/schemas/credential-renewal-offer-response.json",
  "title": "CredentialRenewalOfferResponse",
  "description": "Public wallet handoff produced for an eligible issued-credential renewal.",
  "type": "object",
  "required": ["source_credential_id", "transaction_id", "credential_offer_uri", "credential_offer_uris", "credential_offer_labels", "expires_at"],
  "additionalProperties": false,
  "properties": {
    "source_credential_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "transaction_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "credential_offer_uri": {"type": "string", "minLength": 1, "maxLength": 16384},
    "credential_offer_uris": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 16384}
    },
    "credential_offer_labels": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 255}
    },
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
