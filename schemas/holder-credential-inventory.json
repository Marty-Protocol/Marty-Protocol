{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/marty-protocol/marty-protocol/main/schemas/holder-credential-inventory.json",
  "title": "HolderCredentialInventory",
  "description": "Privacy-filtered response from GET /v1/issued-credentials/mine. Credential material, claims, hashes, signing references, and opaque subject identifiers are prohibited.",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "total", "limit", "offset"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "organization_id", "credential_template_id", "status", "issued_at"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "organization_id": {"type": "string", "format": "uuid"},
          "application_id": {"type": ["string", "null"], "format": "uuid"},
          "credential_template_id": {"type": "string", "format": "uuid"},
          "credential_display_name": {"type": ["string", "null"]},
          "credential_format": {"type": ["string", "null"]},
          "issuer_did": {"type": ["string", "null"]},
          "issuer_name": {"type": ["string", "null"]},
          "status": {"type": "string", "enum": ["ACTIVE", "SUSPENDED", "REVOKED", "EXPIRED"]},
          "issued_at": {"type": "string", "format": "date-time"},
          "valid_until": {"type": ["string", "null"], "format": "date-time"},
          "image_url": {"type": ["string", "null"], "format": "uri"}
        }
      }
    },
    "total": {"type": "integer", "minimum": 0},
    "limit": {"type": "integer", "minimum": 1, "maximum": 500},
    "offset": {"type": "integer", "minimum": 0}
  }
}
