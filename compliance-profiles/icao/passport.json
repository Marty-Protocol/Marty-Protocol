{
  "id": "cp-icao-passport",
  "name": "ICAO Physical ePassport",
  "compliance_code": "ICAO_PASSPORT",
  "version": "2.0.0",
  "credential_format": "ICAO_EMRTD",
  "issuance_protocol": "PHYSICAL_DOCUMENT",
  "description": "Draft MIP mapping for a TD3 ePassport booklet, its contactless integrated circuit, Logical Data Structure, security mechanisms, and PKI. The profile is non-discoverable until format-native personalization and inspection-system conformance tests exist.",
  "specification_reference": "ICAO Doc 9303 Parts 4 and 9-12",
  "required_claims": [
    {"name": "data_group_1", "namespace": "com.icao.passport", "description": "DG1: TD3 machine-readable-zone data", "required": true},
    {"name": "data_group_2", "namespace": "com.icao.passport", "description": "DG2: encoded facial biometric", "required": true},
    {"name": "data_group_3", "namespace": "com.icao.passport", "description": "DG3: encoded fingerprint biometric, protected when present", "required": false},
    {"name": "data_group_4", "namespace": "com.icao.passport", "description": "DG4: encoded iris biometric, protected when present", "required": false},
    {"name": "data_group_7", "namespace": "com.icao.passport", "description": "DG7: displayed signature or usual-mark image", "required": false},
    {"name": "data_group_11", "namespace": "com.icao.passport", "description": "DG11: additional personal details", "required": false},
    {"name": "data_group_12", "namespace": "com.icao.passport", "description": "DG12: additional document details", "required": false},
    {"name": "data_group_14", "namespace": "com.icao.passport", "description": "DG14: security-options data", "required": false},
    {"name": "data_group_15", "namespace": "com.icao.passport", "description": "DG15: Active Authentication public-key information", "required": false},
    {"name": "sod", "namespace": "com.icao.passport", "description": "EF.SOD: CMS SignedData containing the LDS Security Object and data-group hashes", "required": true}
  ],
  "required_namespaces": ["com.icao.passport"],
  "issuer_artifact_requirements": {
    "requires_x509_cert": true,
    "cert_key_usage": ["digitalSignature"]
  },
  "key_requirements": {
    "trust_anchor": "CSCA",
    "document_signer_certificate_required": true,
    "validation_reference": "ICAO Doc 9303 Part 12"
  },
  "pki_hierarchy": {
    "root": "CSCA",
    "leaf": "Document Signer Certificate",
    "csca_key_usage": ["keyCertSign", "cRLSign"],
    "document_signer_key_usage": ["digitalSignature"]
  },
  "physical_production": {
    "required": true,
    "booklet_types": ["TD3"],
    "chip_standard": "ISO/IEC 14443",
    "data_group_encoding": "ICAO LDS ASN.1 DER",
    "access_control": {
      "bac": {"applicability": "document-generation dependent", "reference": "ICAO Doc 9303 Part 11"},
      "pace": {"applicability": "document-generation dependent", "reference": "ICAO Doc 9303 Part 11"},
      "eac": {"protected_data_groups": ["DG3", "DG4"], "reference": "ICAO Doc 9303 Part 11"},
      "active_authentication": {"required": false, "reference": "ICAO Doc 9303 Part 11"},
      "chip_authentication": {"required": false, "reference": "ICAO Doc 9303 Part 11"}
    }
  },
  "trust_profile_constraints": {
    "compatible_profile_types": ["ICAO", "CUSTOM"],
    "required_source_types": ["PKD_URL", "ROOT_CA"],
    "required_formats": ["ICAO_EMRTD"]
  },
  "revocation_methods": ["CRL"],
  "revocation_required": true,
  "allow_skip_revocation": false,
  "trust_source_types": ["PKD_URL", "ROOT_CA"],
  "holder_binding_required": false,
  "is_system": true,
  "immutable": false,
  "status": "DRAFT",
  "discoverable": false,
  "created_at": "2026-07-15T00:00:00Z",
  "updated_at": "2026-08-01T00:00:00Z"
}
